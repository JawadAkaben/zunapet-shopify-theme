<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#fff8ef">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="icon" type="image/png" href="https://cdn.shopify.com/s/files/1/0987/1546/8104/files/zunapet-favicon.png?v=1790427395">
    <title>{% if page_title %}{{ page_title }}{% else %}Zunapet{% endif %}{% unless page_title contains 'Zunapet' %} · Zunapet{% endunless %}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {{ content_for_header }}
    {{ 'zunapet.css' | asset_url | stylesheet_tag }}
  </head>
  <body>
    <div class="zp-announcement">🐾 Envío con seguimiento · Compra segura · Atención cercana</div>

    <header class="zp-header">
      <a href="{{ routes.root_url }}" class="zp-brand" aria-label="Zunapet - Inicio">
        <img src="https://cdn.shopify.com/s/files/1/0987/1546/8104/files/zunapet-logo.png?v=1790426233" alt="Zunapet" class="zp-logo" width="220" height="76">
      </a>
      <nav class="zp-nav" aria-label="Navegación principal">
        <a href="{{ routes.root_url }}">Inicio</a>
        <a href="/products/guante-quitapelos-reutilizable-zunapet">Guante quitapelos</a>
        <a href="/collections/all">Productos</a>
      </nav>
      <div class="zp-actions">
        <a href="{{ routes.search_url }}" aria-label="Buscar">⌕</a>
        <a href="{{ routes.cart_url }}" aria-label="Carrito">Bolsa <span class="zp-cart-count">{{ cart.item_count }}</span></a>
      </div>
    </header>

    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>

    <footer class="zp-footer">
      <div>
        <img src="https://cdn.shopify.com/s/files/1/0987/1546/8104/files/zunapet-logo.png?v=1790426233" alt="Zunapet" class="zp-footer-logo" width="180" height="62">
        <p>Productos prácticos para disfrutar más de la vida con perros y gatos.</p>
      </div>
      <div>
        <strong>Información</strong>
        <a href="{{ routes.search_url }}">Buscar</a>
        <a href="/collections/all">Todos los productos</a>
        <a href="/pages/politica-de-devoluciones">Devoluciones</a>
        <a href="/pages/politica-de-envios">Envíos</a>
        <a href="/pages/politica-de-privacidad">Privacidad</a>
        <a href="/pages/terminos-del-servicio">Términos</a>
      </div>
      <div>
        <strong>Compra con tranquilidad</strong>
        <p>Pago seguro mediante Shopify Payments.</p>
        <p>Seguimiento de envío cuando el pedido sale del proveedor.</p>
      </div>
    </footer>

    <div class="zp-copyright">© {{ 'now' | date: '%Y' }} Zunapet</div>
  </body>
</html>